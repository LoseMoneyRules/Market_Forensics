# Market Forensics 0.1.6 — never commit production values.
MF_ENV=production
MF_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST/DATABASE?charset=utf8mb4
MF_SECRET_KEY=replace-with-existing-production-secret
MF_ENCRYPTION_KEY=replace-with-existing-production-fernet-key
MF_SESSION_DAYS=7
MF_SITE_NAME=Market Forensics
MF_AUTO_MIGRATE=1
# Optional absolute/static URL for a custom logo.
MF_LOGO_URL=

# Optional CONTROL monitoring email channel.
# Leave MF_SMTP_HOST / MF_SMTP_FROM empty to keep email safely disabled;
# in-app alerts and trigger audit remain available.
MF_SMTP_HOST=
MF_SMTP_PORT=587
MF_SMTP_USER=
MF_SMTP_PASSWORD=
MF_SMTP_FROM=
MF_SMTP_STARTTLS=1
MF_SMTP_SSL=0
